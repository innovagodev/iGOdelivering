# Copia questo file in .env e compila i valori. NON metterci segreti veri:
# questo file è nel repository.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server. Dà accesso completo al database: mai nel browser, mai in un commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sito ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# ── Stripe (pagamenti online) ───────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Segreto dell'endpoint webhook Connect (whsec_…)
STRIPE_WEBHOOK_SECRET=

# ── Scarto automatico degli ordini non accettati (job pg_cron) ──────────────
# Stringa casuale lunga, per esempio: openssl rand -hex 32
CRON_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
